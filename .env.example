# Used by docker-compose.yml (copy to .env). Backend dev settings live in backend/.env.
DOMAIN=trace.example.com
POSTGRES_PASSWORD=change-me
# Encrypts stored 2FA secrets. Generate with: openssl rand -hex 32. Changing it later disables existing 2FA enrolments.
APP_SECRET=
ETHERSCAN_API_KEY=
TRONGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=USDT Trace <alerts@example.com>
MONITOR_INTERVAL_SEC=120
