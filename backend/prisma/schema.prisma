generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Platform (Phase 6) ----------

model Org {
  id          Int      @id @default(autoincrement())
  name        String
  require2fa  Boolean  @default(false)
  sessionDays Int      @default(14)
  createdAt   DateTime @default(now())
  users       User[]
  roles       Role[]
}

/// System roles (Owner/Admin/Analyst/Viewer) are code-defined and re-synced at boot; custom roles are editable.
model Role {
  id          Int      @id @default(autoincrement())
  orgId       Int
  org         Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  description String   @default("")
  system      Boolean  @default(false)
  permissions String[]
  createdAt   DateTime @default(now())
  users       User[]

  @@unique([orgId, name])
}

model User {
  id                 Int       @id @default(autoincrement())
  orgId              Int
  org                Org       @relation(fields: [orgId], references: [id])
  roleId             Int
  role               Role      @relation(fields: [roleId], references: [id])
  email              String    @unique
  name               String
  passwordHash       String
  status             String    @default("active") // active | disabled
  mustChangePassword Boolean   @default(false)
  totpSecret         String? // sealed (see totp.ts); set while enrolling, active once totpEnabled
  totpEnabled        Boolean   @default(false)
  totpLastStep       Int       @default(0) // blocks replay of a used code
  recoveryCodes      String[] // sha256 hashes, one-time
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  sessions           Session[]
}

model Session {
  id         String   @id // sha256 of the cookie token
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  ip         String?
  userAgent  String?
  expiresAt  DateTime
}

model ApiKey {
  id              Int       @id @default(autoincrement())
  orgId           Int
  name            String
  prefix          String // first chars, shown in UI to identify the key
  keyHash         String    @unique
  rateLimitPerMin Int       @default(60)
  usageCount      Int       @default(0)
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  createdById     Int?
  createdAt       DateTime  @default(now())
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  orgId     Int
  userId    Int?
  action    String // e.g. case.create, case.export, label.delete
  target    String
  detail    Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([orgId, createdAt])
}

// ---------- Screening (Phase 2) ----------

/// orgId 0 = global label (OFAC, Tether, public imports); otherwise private to that org.
model Label {
  id         Int      @id @default(autoincrement())
  orgId      Int      @default(0)
  chain      String // tron | eth | bsc
  address    String // eth lowercase, tron base58
  name       String
  category   String
  source     String // ofac | tether | circle | manual | import | cluster | official
  sourceUrl  String? // provenance page for source=official (fetched and quoted from the vendor, never invented)
  confidence Float    @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([chain, address, source, orgId])
  @@index([chain, address])
}

/// Postgres-backed job queue (instead of Redis/BullMQ).
model Job {
  id        Int      @id @default(autoincrement())
  orgId     Int
  type      String // screen | cluster
  status    String   @default("queued") // queued | running | done | failed
  payload   Json
  result    Json?
  error     String?
  progress  Int      @default(0)
  total     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, id])
}

/// Small key/value store for sync cursors (e.g. last imported Tether freeze event).
model Setting {
  key   String @id
  value String
}

// ---------- Monitoring (Phase 3) ----------

model Watchlist {
  id        Int         @id @default(autoincrement())
  orgId     Int
  name      String
  createdAt DateTime    @default(now())
  items     WatchItem[]
  rules     Rule[]
}

model WatchItem {
  id            Int       @id @default(autoincrement())
  watchlistId   Int
  watchlist     Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  chain         String
  address       String
  note          String?
  lastSeenTs    BigInt? // ms timestamp of newest transfer already evaluated
  lastCheckedAt DateTime?
  createdAt     DateTime  @default(now())
  alerts        Alert[]

  @@unique([watchlistId, chain, address])
}

model Rule {
  id          Int       @id @default(autoincrement())
  watchlistId Int
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  type        String // amount_over | flagged_counterparty | volume_spike
  params      Json
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  alerts      Alert[]
}

model Alert {
  id           Int       @id @default(autoincrement())
  orgId        Int
  watchItemId  Int
  watchItem    WatchItem @relation(fields: [watchItemId], references: [id], onDelete: Cascade)
  ruleId       Int
  rule         Rule      @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  dedupKey     String // tx hash, or spike:<hour bucket>
  chain        String
  asset        String    @default("usdt") // usdt | usdc
  address      String
  counterparty String?
  amount       Float?
  txHash       String?
  detail       String
  status       String    @default("open") // open | reviewing | closed
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([ruleId, watchItemId, dedupKey])
  @@index([orgId, status, createdAt])
}

model NotifyTarget {
  id        Int      @id @default(autoincrement())
  orgId     Int
  type      String // email | webhook
  target    String // email address or URL
  secret    String? // webhook HMAC secret
  createdAt DateTime @default(now())
}

// ---------- Cases (Phase 4) ----------

model Case {
  id          Int           @id @default(autoincrement())
  orgId       Int
  title       String
  description String        @default("")
  status      String        @default("open") // open | closed
  graphJson   Json?
  graphPng    String? // data URL captured from the graph workspace
  createdById Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  addresses   CaseAddress[]
  notes       CaseNote[]
  files       CaseFile[]
  txs         CaseTransaction[]
  analyses    CaseAnalysis[]
}

model CaseAddress {
  id      Int    @id @default(autoincrement())
  caseId  Int
  case    Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  chain   String
  address String
  role    String @default("other") // suspect | victim | exchange | intermediary | other
  note    String @default("")

  @@unique([caseId, chain, address])
}

model CaseNote {
  id        Int      @id @default(autoincrement())
  caseId    Int
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  authorId  Int?
  body      String
  createdAt DateTime @default(now())
}

model CaseFile {
  id           Int      @id @default(autoincrement())
  caseId       Int
  case         Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  name         String
  storedName   String
  size         Int
  mime         String
  uploadedById Int?
  createdAt    DateTime @default(now())
  txs          CaseTransaction[]
}

/// A transaction attached to a case: pasted by hash or imported from an exchange statement (claimed*), then verified against the chain (on*).
model CaseTransaction {
  id         Int       @id @default(autoincrement())
  caseId     Int
  case       Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  chain      String? // tron | eth | bsc; null when the statement's network is unknown
  hash       String? // null for off-chain (exchange-internal) rows
  source     String    @default("manual") // manual | import
  fileId     Int? // the stored statement
  file       CaseFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)
  rowNo      Int? // spreadsheet row
  claimedAt  DateTime? // statement time, converted to UTC
  coin       String?
  network    String?
  amount     Float? // net amount received, as claimed
  fee        Float?
  address    String? // claimed destination
  ref        String? // exchange reference for off-chain rows
  raw        Json? // original row, values only
  status     String    @default("pending") // pending | verified | mismatch | not_found | off_chain | error
  onFrom     String?
  onTo       String?
  onAmount   Float?
  onAsset    String?
  onAt       DateTime?
  reasons    Json      @default("[]") // string[]: why it is a mismatch / error
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([caseId, chain, hash])
  @@index([caseId, status])
}

// ---------- Attribution (Phase 5) ----------

model ClusterSuggestion {
  id         Int      @id @default(autoincrement())
  orgId      Int
  chain      String
  address    String
  name       String
  category   String
  confidence Float
  evidence   Json
  status     String   @default("pending") // pending | accepted | rejected
  createdAt  DateTime @default(now())

  @@unique([orgId, chain, address, name])
}

// ---------- Own transfer index (Phase 7A) ----------
// Global chain data (not org-scoped). One row per token transfer; `seq` = ordinal of identical
// (hash, from, to, amount) rows within one tx, because TronGrid's per-account list has no log index.

model Transfer {
  id     BigInt  @id @default(autoincrement())
  chain  String // tron | eth | bsc
  asset  String  @default("usdt") // usdt | usdc
  hash   String
  seq    Int     @default(0)
  from   String
  to     String
  amount Decimal @db.Decimal(80, 6) // wide enough for uint256-sized garbage values some contracts emit
  ts     BigInt // ms since epoch
  block  BigInt?

  @@unique([chain, asset, hash, from, to, amount, seq])
  @@index([chain, from, ts])
  @@index([chain, to, ts])
  @@index([chain, ts])
}

/// Which wallets have their full history in Transfer. status: pending | backfilling | complete | capped | error
model IndexedAddress {
  id         Int       @id @default(autoincrement())
  chain      String
  address    String
  status     String    @default("pending")
  reason     String    @default("lookup") // lookup | watch | case | manual
  assets     String    @default("") // csv of assets whose full history is stored (a new asset in the registry re-queues the wallet)
  retries    Int       @default(0) // automatic retries after a failed backfill (bounded, with back-off)
  retryAt    DateTime? // earliest time the next automatic retry may start
  rowCount   Int       @default(0)
  oldestTs   BigInt?
  newestTs   BigInt?
  lastSyncAt DateTime?
  error      String?
  createdAt  DateTime  @default(now())

  @@unique([chain, address])
  @@index([status])
}

/// Full-chain tailer position. cursor = ms timestamp (tron) or block number (eth).
/// `since` = ms when the tailer started; every transfer after it is in the table, so wallets synced after it need no API call.
model IndexCursor {
  chain     String   @id
  cursor    BigInt
  cursorTs  BigInt // ms of the newest data indexed
  since     BigInt
  rowsTotal BigInt   @default(0)
  error     String?
  updatedAt DateTime @updatedAt
}

/// One run of the case analysis (8B). `result` is the stored report the UI and the printable report read; a new run is a new row.
model CaseAnalysis {
  id          Int       @id @default(autoincrement())
  caseId      Int
  case        Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  status      String    @default("queued") // queued | running | done | failed
  stage       String    @default("")
  params      Json
  result      Json?
  error       String?
  progress    Int       @default(0)
  total       Int       @default(0)
  jobId       Int?
  createdById Int?
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([caseId, id])
}
