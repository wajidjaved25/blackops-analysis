# ---- Required ----
# Postgres connection (also used for the background job queue)
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/usdt_trace

# ---- Chain data ----
# Required for Ethereum AND BNB Chain (Etherscan API v2: one key, chainid=1 / 56; free key: https://etherscan.io/myapikey).
# Without it every 0x address returns a clear error and the Ethereum Tether/Circle freeze syncs are skipped. Tron works without it.
# Note: Etherscan's free plan may not cover BNB Chain; check your plan if BNB Chain calls are refused.
ETHERSCAN_API_KEY=
# 7C cross-chain: the bridge hop finder's Ethereum / BNB Chain side and swap detection on 0x transactions also need ETHERSCAN_API_KEY
# (txlistinternal, getblocknobytime); without it the API says so per chain instead of returning an empty result.
# Optional, raises Tron rate limits (https://www.trongrid.io)
TRONGRID_API_KEY=

# ---- Server ----
PORT=4000
# true when running behind Caddy/nginx so rate limits and the audit log see the real client IP
TRUST_PROXY=false
# true when served over HTTPS (adds the Secure flag to the session cookie)
COOKIE_SECURE=false
# Set DISABLE_WORKERS=true for an API-only instance (no jobs, monitoring or sync timers)
DISABLE_WORKERS=false

# ---- Redis (chain-data cache + rate limits). Falls back to in-memory with one warning if unreachable. ----
REDIS_URL=redis://localhost:6379

# ---- Security ----
# State-changing requests must be JSON and (when the browser sends an Origin) come from the site's own host.
# Add extra trusted origins here, comma-separated, e.g. https://trace.example.com
ALLOWED_ORIGINS=
# Encrypts stored 2FA secrets (AES-256-GCM). Generate: openssl rand -hex 32. If unset, secrets are stored unencrypted.
APP_SECRET=
# DEVELOPMENT ONLY: allow webhook / label-import URLs that point at localhost or private networks (SSRF guard off)
ALLOW_PRIVATE_URLS=false

# ---- Monitoring & notifications ----
MONITOR_INTERVAL_SEC=120
# Risk-change alerts (rule type risk_change): re-score a watched wallet at most this often, and at most this many wallets per monitoring pass
RISK_RECHECK_SEC=3600
RISK_MAX_PER_POLL=5
# Email alerts. Local testing: run Mailpit and use SMTP_HOST=localhost SMTP_PORT=1025 (inbox at http://localhost:8025)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Tracera <alerts@localhost>

# ---- Case files ----
# Where uploads are stored (default: ./uploads next to where the API starts)
UPLOAD_DIR=

# ---- Own transfer index (Phase 7A) ----
# Wallets above this many transfers are marked "capped" (exchanges have millions); the newest N are kept
INDEX_MAX_PER_ADDRESS=50000
# A covered wallet is re-synced (newer rows only) when its last sync is older than this
INDEX_FRESH_SEC=300
# Full-chain tailer, OFF by default: free TronGrid cannot keep up with ~2-3M USDT transfers/day. Examples: tron | tron,eth
# It follows USDT only; USDC and BNB Chain enter the index through per-wallet backfills. Failed backfills retry by themselves (1/2/4/8/16 min).
INDEX_TAIL=
# Required for the Ethereum tailer (eth_getLogs). Any JSON-RPC endpoint; the key is part of the URL, so keep it in .env only
ETH_RPC_URL=

# ---- Explorer tags (Phase 8C, optional) ----
# Free key from tronscan.org (API keys page). Enables lazy public-tag lookups (POST /labels/explorer-tag); sent only to apilist.tronscanapi.com
TRONSCAN_API_KEY=

# ---- AI investigation assistant (Phase 9D, optional) ----
# OFF by default. When false every /ai/* endpoint returns 503 "AI assistant is coming soon" and no request is ever sent to the provider.
AI_ENABLED=false
# Secret key from console.anthropic.com. Server-side only; never sent to the browser. Only read when AI_ENABLED=true
ANTHROPIC_API_KEY=
# Claude model used for summaries and questions (default claude-sonnet-5-5)
AI_MODEL=claude-sonnet-5-5
